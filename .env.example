OKX_DEMO_API_PASSPHRASE=

# Реальные ключи. Используются ТОЛЬКО если OKX_LIVE_TRADING=true
# и после подтверждения кодом в локальном интерфейсе бота.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_LIVE_TRADING=false

