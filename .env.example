# ===== OKX =====
# DEMO-ключи (создаются в режиме Demo Trading на okx.com). Права: Read + Trade. БЕЗ Withdraw.
OKX_DEMO_API_KEY=
OKX_DEMO_API_SECRET=
OKX_DEMO_API_PASSPHRASE=

# Реальные ключи. Используются ТОЛЬКО если OKX_LIVE_TRADING=true
# и после подтверждения командой /confirm_live <код> в Telegram.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_LIVE_TRADING=false

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=
# Ваш личный chat_id (бот отвечает только ему)
TELEGRAM_CHAT_ID=

# ===== Claude API (опционально, для разбора в дайджесте) =====
ANTHROPIC_API_KEY=
